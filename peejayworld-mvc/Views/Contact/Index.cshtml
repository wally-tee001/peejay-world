@using peejayworld_mvc.Models
@model ContactMessage?

@{
    ViewData["Title"] = "Contact";
    var success = ViewBag.Success as bool? ?? false;
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Contact Us</p>
            <h1>Were here to help and answer your questions.</h1>
            <p>Send us a message and well get back to you soon with the support you need.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Get in touch</p>
            <h2>Wed love to hear from you.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>Email</span>
                    <h3>Support Team</h3>
                    <p>Reach us at <a href="mailto:hello@peejaysworld.com">hello@peejaysworld.com</a> for questions, feedback, or requests.</p>
                    <p>We aim to reply within one business day.</p>
                </div>
            </article>

            <article class="card product-card">
                <div class="card-body">
                    <form id="contact-form" class="page-form" asp-controller="Contact" asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="form-error-summary" role="alert"></div>

                        <label asp-for="Name"></label>
                        <input asp-for="Name" placeholder="Your full name" />
                        <span asp-validation-for="Name" class="field-validation-error"></span>

                        <label asp-for="Email"></label>
                        <input asp-for="Email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>

                        <label asp-for="Subject"></label>
                        <input asp-for="Subject" placeholder="How can we help?" />
                        <span asp-validation-for="Subject" class="field-validation-error"></span>

                        <label asp-for="Message"></label>
                        <textarea asp-for="Message" placeholder="Write your message here"></textarea>
                        <span asp-validation-for="Message" class="field-validation-error"></span>

                        <button type="submit" class="btn btn-primary">Send Message</button>

                        <p id="contact-success" class="form-success" hidden="@(success ? null : "hidden")">Thank you! Your message has been submitted.</p>
                    </form>
                </div>
            </article>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

