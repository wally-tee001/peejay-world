@{
    ViewData["Title"] = "Cosmetics";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Cosmetics</p>
            <h1>Make every look feel effortlessly glamorous.</h1>
            <p>Shop luminous makeup essentials, rich pigments, and curated beauty tools for all styles.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Beauty Picks</p>
            <h2>Refined cosmetics tailored for modern beauty.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=800&q=80" alt="Makeup palette" loading="lazy" />
                <div class="card-body">
                    <span>Makeup</span>
                    <h3>Radiant Complexion</h3>
                    <p>Buildable foundations, blushes, and highlighters for a luminous finish.</p>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=800&q=80" alt="Lipstick collection" loading="lazy" />
                <div class="card-body">
                    <span>Lips</span>
                    <h3>Velvet Shades</h3>
                    <p>Classic reds, soft nudes, and bold finishes for every mood.</p>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=800&q=80" alt="Eye makeup products" loading="lazy" />
                <div class="card-body">
                    <span>Eyes</span>
                    <h3>Defined Glamour</h3>
                    <p>Smoky shadows, precise liners, and lashes to frame your gaze.</p>
                </div>
            </article>
        </div>
    </div>
</section>