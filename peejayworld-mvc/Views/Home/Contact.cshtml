@{
    ViewData["Title"] = "Contact";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Contact Us</p>
            <h1>We’re here to help and answer your questions.</h1>
            <p>Send us a message and we’ll get back to you soon with the support you need.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Get in touch</p>
            <h2>We’d love to hear from you.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>Email</span>
                    <h3>Support Team</h3>
                    <p>Reach us at <a href="mailto:hello@peejaysworld.com">hello@peejaysworld.com</a> for questions, feedback, or requests.</p>
                    <p>We aim to reply within one business day.</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <form id="contact-form" class="page-form">
                        <label for="contact-name">Name</label>
                        <input id="contact-name" type="text" name="name" placeholder="Your full name" required />

                        <label for="contact-email">Email</label>
                        <input id="contact-email" type="email" name="email" placeholder="you@example.com" required />

                        <label for="contact-subject">Subject</label>
                        <input id="contact-subject" type="text" name="subject" placeholder="How can we help?" required />

                        <label for="contact-message">Message</label>
                        <textarea id="contact-message" name="message" placeholder="Write your message here" required></textarea>

                        <button type="submit" class="btn btn-primary">Send Message</button>
                        <p id="contact-success" class="form-success" hidden>Thank you! Your message has been submitted.</p>
                    </form>
                </div>
            </article>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const contactForm = document.getElementById('contact-form');
        if (contactForm) {
            contactForm.addEventListener('submit', function (event) {
                event.preventDefault();
                const name = document.getElementById('contact-name').value.trim();
                const email = document.getElementById('contact-email').value.trim();
                const subject = document.getElementById('contact-subject').value.trim();
                const message = document.getElementById('contact-message').value.trim();
                if (!name || !email || !subject || !message) {
                    return;
                }
                document.getElementById('contact-success').hidden = false;
                contactForm.reset();
            });
        }
    </script>
}