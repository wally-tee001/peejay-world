@{
    ViewData["Title"] = "About";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Fashion House</p>
            <h1>Where beauty and style come together.</h1>
            <p>Peejay's World is your destination for fashion insight, trend direction, and polished style information.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Our Vision</p>
            <h2>Deliver fashion insights that feel modern and elevated.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>Who We Are</span>
                    <h3>Style Curators</h3>
                    <p>We bring elegant fashion guidance and approachable trend stories to your mobile feed.</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>What We Do</span>
                    <h3>Inspire your wardrobe</h3>
                    <p>From outfit ideas to beauty notes, every page is designed to help you look and feel your best.</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Why It Works</span>
                    <h3>Polished and easy to use</h3>
                    <p>We keep fashion content clean, modern, and simple enough to enjoy on any device.</p>
                </div>
            </article>
        </div>
    </div>
</section>