@{
    ViewData["Title"] = "Personal Care";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Personal Care</p>
            <h1>Beauty starts with thoughtful self-care.</h1>
            <p>Explore premium body, skincare and wellness essentials designed to refresh your daily routine.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Care Essentials</p>
            <h2>Elevated personal care picks for every moment.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=800&q=80" alt="Skincare essentials" loading="lazy" />
                <div class="card-body">
                    <span>Skincare</span>
                    <h3>Daily Glow Rituals</h3>
                    <p>Hydrating formulas, gentle cleansers, and nourishing creams for radiant skin.</p>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=800&q=80" alt="Body care products" loading="lazy" />
                <div class="card-body">
                    <span>Body Care</span>
                    <h3>Silky Smooth Touch</h3>
                    <p>Luxurious lotions and scrubs for a polished, silky finish every day.</p>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1514986888952-8cd320577b5c?auto=format&fit=crop&w=800&q=80" alt="Wellness essentials" loading="lazy" />
                <div class="card-body">
                    <span>Wellness</span>
                    <h3>Calming Self-Care</h3>
                    <p>Relaxing bath blends, aromatherapy and gentle rituals for mindful beauty.</p>
                </div>
            </article>
        </div>
    </div>
</section>