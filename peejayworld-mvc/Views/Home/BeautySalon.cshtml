@{
    ViewData["Title"] = "Beauty Salon";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Beauty Salon</p>
            <h1>Luxury salon experiences for head-to-toe beauty.</h1>
            <p>Discover signature styling, treatments, and pampering services for a glowing transformation.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Salon Services</p>
            <h2>Curated beauty treatments for every visit.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=800&q=80" alt="Hair styling" loading="lazy" />
                <div class="card-body">
                    <span>Styling</span>
                    <h3>Signature Hair</h3>
                    <p>Expert cuts, color, and styling for a polished look.</p>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1515378791036-0648a3ef77b2?auto=format&fit=crop&w=800&q=80" alt="Facial treatment" loading="lazy" />
                <div class="card-body">
                    <span>Treatments</span>
                    <h3>Skin Renewal</h3>
                    <p>Glow-boosting facials and luxurious skin services for radiant results.</p>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=800&q=80" alt="Makeup service" loading="lazy" />
                <div class="card-body">
                    <span>Makeover</span>
                    <h3>Glam Sessions</h3>
                    <p>Professional makeup and finishing touches for special occasions.</p>
                </div>
            </article>
        </div>
    </div>
</section>