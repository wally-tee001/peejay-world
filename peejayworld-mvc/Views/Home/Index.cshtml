@{
    ViewData["Title"] = "Home";
    var subscribed = Context.Request.Query["subscribed"].ToString() == "true";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Peejay's World — fashion, beauty, luxury</p>
            <h1>Elevate your look with timeless style.</h1>
            <p>Discover chic beauty stories, trend-forward style edits, and polished fashion essentials.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse Collections</a>
                <a asp-area="" asp-controller="Home" asp-action="PersonalCare" class="btn btn-secondary">Shop Beauty</a>
            </div>
        </div>
        <div class="hero-badge">
            <div class="badge-card">
                <span>Latest Update</span>
                <strong>New Collection</strong>
                <p>A curated edit of beauty looks and style must-haves.</p>
            </div>
        </div>
    </div>
</section>

<section class="section quote-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Beauty Quotes</p>
            <h2>Inspiration for your style journey.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>Quote</span>
                    <h3>Beauty begins</h3>
                    <p>"Beauty begins the moment you decide to be yourself." — Coco Chanel</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Quote</span>
                    <h3>Style is a message</h3>
                    <p>"Style is a way to say who you are without having to speak." — Rachel Zoe</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Quote</span>
                    <h3>Confidence and beauty</h3>
                    <p>"The best thing is to look natural, but it takes makeup to look natural." — Calvin Klein</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="collections" class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">top products</p>
            <h2>get high quality product.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <img src="~/Cosmetics/Cosmetics1.avif" alt="Makeup palette" loading="lazy" />
                <div class="card-body">
                    <span>Diamond Lip Gloss</span>
                    <h3>Shine Bright</h3>
                    <p>Experience the ultimate in lip luxury with our Diamond Lip Gloss, a shimmering formula for radiant shine.</p>
                    <a asp-area="" asp-controller="Home" asp-action="PersonalCare" class="text-link">Explore the Look</a>
                </div>
            </article>
            <article class="card product-card">
                <img src="~/Cosmetics/Cosmetics2.webp" alt="Lipstick set" loading="lazy" />
                <div class="card-body">
                    <span>Golden Highlighter</span>
                    <h3>Glow Like the Sun</h3>
                    <p>Build a warm, luminous glow with our silky highlighter that catches every light.</p>
                    <a asp-area="" asp-controller="Home" asp-action="CosmeticsStore" class="text-link">Explore Cosmetics</a>
                </div>
            </article>
            <article class="card product-card">
                <img src="~/Cosmetics/cosmetics3.jpg" alt="Compact silks" loading="lazy" />
                <div class="card-body">
                    <span>Silk Serum</span>
                    <h3>Silky Smooth Skin</h3>
                    <p>Keep your skin soft and luminous with a nurturing serum designed for all-day comfort.</p>
                    <a asp-area="" asp-controller="Home" asp-action="BeautySalon" class="text-link">Explore Treatments</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="more-links" class="section more-links-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Explore Pages</p>
            <h2>Open the most relevant fashion and beauty areas of the site.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>About Us</span>
                    <h3>Who We Are</h3>
                    <p>Learn about Peejay's World, our mission, and how we help keep you glowing.</p>
                    <a asp-area="" asp-controller="Home" asp-action="About" class="text-link">View About Us</a>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Contact Us</span>
                    <h3>Reach Out</h3>
                    <p>Have a question or a suggestion? Contact us directly and we'll get back to you quickly.</p>
                    <a asp-area="" asp-controller="Contact" asp-action="Index" class="text-link">Contact Support</a>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Beauty Salon</span>
                    <h3>Styled Services</h3>
                    <p>Discover salon-inspired beauty rituals, skin prep, and glowing finish tips.</p>
                    <a asp-area="" asp-controller="Home" asp-action="BeautySalon" class="text-link">Visit Salon</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="newsletter" class="section newsletter-section">
    <div class="container newsletter-card">
        <div>
            <p class="eyebrow">Stay in the glow</p>
            <h2>Join our insider list for new launches and private offers.</h2>
        </div>
<form class="newsletter-form" asp-controller="Newsletter" asp-action="Subscribe" method="post">
            @Html.AntiForgeryToken()
            <input type="email" name="Email" placeholder="Enter your email" aria-label="Email address" required />
            <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
        @if (subscribed)
        {
            <p class="form-success">Thank you! You have been added to our newsletter.</p>
        }
    </div>
</section>
