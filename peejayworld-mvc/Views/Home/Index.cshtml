@{
    ViewData["Title"] = "Home";
    var subscribed = Context.Request.Query["subscribed"].ToString() == "true";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Peejay's World — office wear watches</p>
            <h1>Elevate every workday look with premium wristwear.</h1>
            <p>Discover a refined collection of men's and women's office-ready timepieces designed for modern professionals.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-primary">Shop Watches</a>
                <a asp-area="" asp-controller="Home" asp-action="About" class="btn btn-secondary">Our Story</a>
            </div>
        </div>
        <div class="hero-badge">
            <div class="badge-card">
                <span>Featured</span>
                <strong>Premium Selection</strong>
                <p>Polished timepieces that complement professional dressing and executive style.</p>
            </div>
        </div>
    </div>
</section>

<section class="section quote-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Beauty Quotes</p>
            <h2>Inspiration for your style journey.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>Quote</span>
                    <h3>Beauty begins</h3>
                    <p>"Beauty begins the moment you decide to be yourself." — Coco Chanel</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Quote</span>
                    <h3>Style is a message</h3>
                    <p>"Style is a way to say who you are without having to speak." — Rachel Zoe</p>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Quote</span>
                    <h3>Confidence and beauty</h3>
                    <p>"The best thing is to look natural, but it takes makeup to look natural." — Calvin Klein</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="collections" class="section collections-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Featured timepieces</p>
            <h2>Office-ready watches for him and her.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <img src="https://rukmini1.flixcart.com/image/300/300/xif0q/watch/2/n/w/1-a-01-silver-watchions-men-original-imahmhzx5p89n3wt.jpeg" alt="Men's Silver Chronograph" loading="lazy" />
                <div class="card-body">
                    <span>Men's Watch</span>
                    <h3>Silver Chronograph</h3>
                    <p>Sleek stainless steel and precision movement built for confident professional styling.</p>
                    <a asp-area="" asp-controller="Products" asp-action="Index" class="text-link">Shop now</a>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://ng.jumia.is/unsafe/fit-in/300x300/filters:fill(white)/product/80/0145814/1.jpg?5982" alt="Classic Leather Dress Watch" loading="lazy" />
                <div class="card-body">
                    <span>Men's Watch</span>
                    <h3>Classic Leather Dress</h3>
                    <p>Timeless leather strap design crafted for elegant boardroom looks.</p>
                    <a asp-area="" asp-controller="Products" asp-action="Index" class="text-link">Shop now</a>
                </div>
            </article>
            <article class="card product-card">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIFTGr56XuM-3vCUeLPVatiUritql9rjS1-ZUAkPGRbv9WrUK4wPHthHM&s=10" alt="Women's Rose Gold Case Watch" loading="lazy" />
                <div class="card-body">
                    <span>Women's Watch</span>
                    <h3>Rose Gold Case</h3>
                    <p>Refined rose gold styling with a chic mesh band for polished office wear.</p>
                    <a asp-area="" asp-controller="Products" asp-action="Index" class="text-link">Shop now</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="more-links" class="section more-links-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Explore Pages</p>
            <h2>Open the most relevant fashion and beauty areas of the site.</h2>
        </div>
        <div class="grid cards-grid">
            <article class="card product-card">
                <div class="card-body">
                    <span>About Us</span>
                    <h3>Who We Are</h3>
                    <p>Learn about Peejay's World, our mission, and how we help keep you glowing.</p>
                    <a asp-area="" asp-controller="Home" asp-action="About" class="text-link">View About Us</a>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Contact Us</span>
                    <h3>Reach Out</h3>
                    <p>Have a question or a suggestion? Contact us directly and we'll get back to you quickly.</p>
                    <a asp-area="" asp-controller="Contact" asp-action="Index" class="text-link">Contact Support</a>
                </div>
            </article>
            <article class="card product-card">
                <div class="card-body">
                    <span>Beauty Salon</span>
                    <h3>Styled Services</h3>
                    <p>Discover salon-inspired beauty rituals, skin prep, and glowing finish tips.</p>
                    <a asp-area="" asp-controller="Home" asp-action="BeautySalon" class="text-link">Visit Salon</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="newsletter" class="section newsletter-section">
    <div class="container newsletter-card">
        <div>
            <p class="eyebrow">Stay in the glow</p>
            <h2>Join our insider list for new launches and private offers.</h2>
        </div>
<form class="newsletter-form" asp-controller="Newsletter" asp-action="Subscribe" method="post">
            @Html.AntiForgeryToken()
            <input type="email" name="Email" placeholder="Enter your email" aria-label="Email address" required />
            <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
        @if (subscribed)
        {
            <p class="form-success">Thank you! You have been added to our newsletter.</p>
        }
    </div>
</section>
