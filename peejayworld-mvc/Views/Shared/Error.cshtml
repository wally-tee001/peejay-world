@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Something went wrong</p>
            <h1>We couldn't complete your request.</h1>
            <p>An unexpected error occurred. Please try again in a moment, or contact us if the problem persists.</p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                <a asp-area="" asp-controller="Contact" asp-action="Index" class="btn btn-secondary">Contact Support</a>
            </div>
        </div>
    </div>
</section>

<section class="section collections-section">
    <div class="container">
        <div class="card product-card">
            <div class="card-body">
                <h3>What you can do</h3>
                <p>Refresh the page and try again. If the issue continues, please reach out to our support team and include the reference below if available.</p>
                @if (Model.ShowRequestId)
                {
                    <p>
                        <strong>Reference:</strong> <code>@Model.RequestId</code>
                    </p>
                }
            </div>
        </div>
    </div>
</section>
