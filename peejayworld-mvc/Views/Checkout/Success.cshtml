@{
    ViewData["Title"] = "Payment success";
}

<div class="section auth-section">
  <div class="auth-card">
    <div class="card-body">
      <h2>Payment successful</h2>
      <p>Thank you for your purchase. Your session id is: <strong>@ViewData["SessionId"]</strong></p>
      <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Return to shop</a>
    </div>
  </div>
</div>
@{
    ViewData["Title"] = "Order Confirmed";
}

<section class="section success-section">
    <div class="container">
        <div class="card product-card">
            <div class="card-body">
                <h2>Thank you for your order!</h2>
                <p>Your purchase is confirmed and we are preparing it for shipment.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
            </div>
        </div>
    </div>
</section>
