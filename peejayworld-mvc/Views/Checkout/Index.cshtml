@model peejayworld_mvc.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<section class="section checkout-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Checkout</p>
            <h2>Complete your order and enter shipping details.</h2>
        </div>

        <div class="checkout-grid">
            <div class="card form-card">
                <div class="card-body">
                    <h3>Shipping details</h3>
                    <form asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label asp-for="FullName"></label>
                            <input asp-for="FullName" />
                            <span asp-validation-for="FullName"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" />
                            <span asp-validation-for="Email"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ShippingAddress"></label>
                            <textarea asp-for="ShippingAddress"></textarea>
                            <span asp-validation-for="ShippingAddress"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Place Order</button>
                    </form>
                </div>
            </div>

            <div class="card cart-summary-card">
                <div class="card-body">
                    <h3>Order summary</h3>
                    @if (Model.Items.Any())
                    {
                        <ul class="order-summary-list">
                            @foreach (var item in Model.Items)
                            {
                                <li>
                                    <div class="summary-item">
                                        <span>@item.Product?.Name</span>
                                        <span>@item.Quantity × @item.Product?.Price.ToString("C")</span>
                                    </div>
                                    <div class="summary-item secondary">
                                        <span>Line total</span>
                                        <strong>@item.TotalPrice.ToString("C")</strong>
                                    </div>
                                </li>
                            }
                        </ul>
                        <div class="summary-total">
                            <span>Total</span>
                            <strong>@Model.OrderTotal.ToString("C")</strong>
                        </div>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-secondary">Back to Cart</a>
                    }
                    else
                    {
                        <p>Your cart is empty.</p>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
