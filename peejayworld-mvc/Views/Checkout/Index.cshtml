@{
  Layout = null;
  ViewData["Title"] = "Checkout";
}

<div class="section auth-section">
  <div class="auth-card">
    <div class="card-body">
      <h2>Checkout</h2>
      <p>Enter an amount to test Stripe Checkout (in major currency units).</p>
      <form method="post" action="/Checkout/CreateSession">
        <div class="page-form">
          <label for="amount">Amount</label>
          <input id="amount" name="amount" type="number" step="0.01" min="0.5" value="9.99" />
          <button class="btn btn-primary" type="submit">Pay with Stripe</button>
        </div>
      </form>
    </div>
  </div>
</div>

