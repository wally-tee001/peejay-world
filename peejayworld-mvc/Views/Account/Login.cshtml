@model peejayworld_mvc.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="section auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-hero">
                <h3>Welcome back</h3>
                <p>Sign in to manage your account or access the admin dashboard.</p>
            </div>
            <div class="card-body">
                <h2 class="mb-3">Sign in</h2>

                <form asp-action="Login" method="post" novalidate class="auth-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="form-error-summary"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="page-form">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>

                        <label asp-for="Password"></label>
                        <input asp-for="Password" type="password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>

                        <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                            <label style="display:flex;align-items:center;gap:0.5rem;">
                                <input asp-for="RememberMe" style="width:auto;" />
                                <span>Remember me</span>
                            </label>
                            <a asp-action="Register">Create account</a>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary w-100">Sign in</button>
                        </div>
                    </div>
                </form>

                <div class="mt-3 auth-note">
                    <p class="mb-1">Need help? Use <strong>admin@peejayworld.com</strong> / <strong>Admin@1234</strong> for seeded admin access in development.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
