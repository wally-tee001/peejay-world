@model IEnumerable<peejayworld_mvc.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<section class="section account-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Order History</p>
            <h2>Review your previous purchases.</h2>
        </div>

        @if (!Model.Any())
        {
            <div class="card product-card">
                <div class="card-body">
                    <h3>You have not placed any orders yet.</h3>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Start Shopping</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Placed</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.Status</td>
                                <td>@order.TotalAmount.ToString("C")</td>
                                <td>@order.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="text-link">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
